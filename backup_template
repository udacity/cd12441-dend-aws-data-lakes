AWSTemplateFormatVersion: '2010-09-09'
Description: 'Complete E-commerce Analytics Pipeline - Batch CDC + Real-time Streaming to Iceberg'

Parameters:
  ProjectName:
    Type: String
    Default: ecommerce-analytics
    Description: Project name for resource naming (no underscores)
  
  Environment:
    Type: String
    Default: dev
    AllowedValues: [dev]
    Description: Environment name

Resources:
  # =====================================================
  # IAM USER FOR DEPLOYMENT
  # =====================================================
  
  DeploymentUser:
    Type: AWS::IAM::User
    Properties:
      UserName: !Sub '${ProjectName}-deployer-${Environment}'

  DeploymentUserAccessKey:
    Type: AWS::IAM::AccessKey
    Properties:
      UserName: !Ref DeploymentUser

  # =====================================================
  # DEPLOYMENT POLICY
  # =====================================================
  
  DeploymentPolicy:
    Type: AWS::IAM::ManagedPolicy
    Properties:
      ManagedPolicyName: !Sub '${ProjectName}-deployment-policy-${Environment}'
      Description: Minimal permissions for CDC pipeline deployment
      Users:
        - !Ref DeploymentUser
      PolicyDocument:
        Version: '2012-10-17'
        Statement:
          # CloudFormation
          - Sid: CloudFormation
            Effect: Allow
            Action:
              - cloudformation:*
            Resource:
              - !Sub 'arn:aws:cloudformation:${AWS::Region}:${AWS::AccountId}:stack/${ProjectName}-*'
          
          - Sid: CloudFormationList
            Effect: Allow
            Action:
              - cloudformation:ListStacks
              - cloudformation:ListExports
              - cloudformation:DescribeStacks
            Resource: '*'
          
          # S3 (only for project buckets)
          - Sid: S3Operations
            Effect: Allow
            Action:
              - s3:*
            Resource:
              - !Sub 'arn:aws:s3:::${ProjectName}-*'
              - !Sub 'arn:aws:s3:::${ProjectName}-*/*'
          
          - Sid: S3List
            Effect: Allow
            Action:
              - s3:ListAllMyBuckets
              - s3:GetBucketLocation
            Resource: '*'

          # Kinesis
          - Sid: Kinesis
            Effect: Allow
            Action:
              - kinesis:*
            Resource:
              - !Sub 'arn:aws:kinesis:${AWS::Region}:${AWS::AccountId}:stream/${ProjectName}-*'

          # Lambda
          - Sid: Lambda
            Effect: Allow
            Action:
              - lambda:*
            Resource:
              - !Sub 'arn:aws:lambda:${AWS::Region}:${AWS::AccountId}:function:${ProjectName}-*'

          # API Gateway
          - Sid: APIGateway
            Effect: Allow
            Action:
              - apigateway:*
            Resource:
              - !Sub 'arn:aws:apigateway:${AWS::Region}::/apis'
              - !Sub 'arn:aws:apigateway:${AWS::Region}::/apis/*'

          # Glue
          - Sid: Glue
            Effect: Allow
            Action:
              - glue:CreateDatabase
              - glue:GetDatabase
              - glue:CreateJob
              - glue:DeleteJob
              - glue:GetJob
              - glue:StartJobRun
              - glue:GetJobRun
              - glue:GetJobRuns
              - glue:CreateTable
              - glue:UpdateTable
              - glue:GetTable
              - glue:DeleteTable
            Resource:
              - !Sub 'arn:aws:glue:${AWS::Region}:${AWS::AccountId}:catalog'
              - !Sub 'arn:aws:glue:${AWS::Region}:${AWS::AccountId}:database/${ProjectName}*'
              - !Sub 'arn:aws:glue:${AWS::Region}:${AWS::AccountId}:table/${ProjectName}*/*'
              - !Sub 'arn:aws:glue:${AWS::Region}:${AWS::AccountId}:job/${ProjectName}-*'
          
          # IAM
          - Sid: IAMRoles
            Effect: Allow
            Action:
              - iam:CreateRole
              - iam:DeleteRole
              - iam:GetRole
              - iam:PutRolePolicy
              - iam:DeleteRolePolicy
              - iam:GetRolePolicy
              - iam:AttachRolePolicy
              - iam:DetachRolePolicy
              - iam:ListAttachedRolePolicies
              - iam:ListRolePolicies
              - iam:PassRole
            Resource:
              - !Sub 'arn:aws:iam::${AWS::AccountId}:role/${ProjectName}-*'
          
          - Sid: IAMList
            Effect: Allow
            Action:
              - iam:ListRoles
              - iam:ListPolicies
              - iam:GetPolicy
              - iam:GetPolicyVersion
            Resource: '*'

  # =====================================================
  # S3 DATA LAKE BUCKET (SINGLE BUCKET FOR GLUE SCRIPTS & DATA)
  # ====================================================

  DataLakeBucket:
    Type: AWS::S3::Bucket
    Properties:
      BucketName: !Sub '${ProjectName}-datalake-${Environment}-${AWS::AccountId}'
      BucketEncryption:
        ServerSideEncryptionConfiguration:
          - ServerSideEncryptionByDefault:
              SSEAlgorithm: AES256
      VersioningConfiguration:
        Status: Suspended
      LifecycleConfiguration:
        Rules:
          - Id: CleanupRule
            Status: Enabled
            ExpirationInDays: 30  # Auto-cleanup after 30 days
            NoncurrentVersionExpirationInDays: 1
            AbortIncompleteMultipartUpload:
              DaysAfterInitiation: 1
      
      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true

  # =====================================================
  # IAM ROLES
  # =====================================================
  
  LambdaCDCRole:
    Type: AWS::IAM::Role
    Properties:
      RoleName: !Sub '${ProjectName}-lambda-cdc-role-${Environment}'
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: lambda.amazonaws.com
            Action: sts:AssumeRole
      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole
      Policies:
        - PolicyName: LambdaCDCPolicy
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - kinesis:PutRecord
                  - kinesis:PutRecords
                  - kinesis:DescribeStream
                Resource: !Sub 'arn:aws:kinesis:${AWS::Region}:${AWS::AccountId}:stream/${ProjectName}-*'

  GlueRole:
    Type: AWS::IAM::Role
    Properties:
      RoleName: !Sub '${ProjectName}-glue-role-${Environment}'
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Principal:
              Service: glue.amazonaws.com
            Action: sts:AssumeRole
      ManagedPolicyArns:
        - arn:aws:iam::aws:policy/service-role/AWSGlueServiceRole
      Policies:
        - PolicyName: GlueS3Policy
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - s3:GetObject
                  - s3:PutObject
                  - s3:DeleteObject
                  - s3:ListBucket
                Resource:
                  - !GetAtt DataLakeBucket.Arn
                  - !Sub '${DataLakeBucket.Arn}/*'
        
        - PolicyName: GlueKinesisPolicy
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              - Effect: Allow
                Action:
                  - kinesis:DescribeStream
                  - kinesis:GetRecords
                  - kinesis:GetShardIterator
                  - kinesis:ListShards
                  - kinesis:ListStreams
                Resource:
                  - !Sub 'arn:aws:kinesis:${AWS::Region}:${AWS::AccountId}:stream/${ProjectName}-*'

  # =====================================================
  # GLUE DATABASE
  # ====================================================

  GlueDatabase:
    Type: AWS::Glue::Database
    Properties:
      CatalogId: !Ref AWS::AccountId
      DatabaseInput:
        Name: !Sub 'ecommerce_analytics_bronze_${Environment}'
        Description: Iceberg catalog for e-commerce analytics bronze layer data
        LocationUri: !Sub 's3://${DataLakeBucket}/iceberg-cdc-bronze/'

  # =====================================================
  # KINESIS STREAM FOR REAL-TIME CLICKSTREAM EVENTS
  # ====================================================

  EventsStream:
    Type: AWS::Kinesis::Stream
    Properties:
      Name: !Sub '${ProjectName}-events-${Environment}'
      ShardCount: 1
      RetentionPeriodHours: 24

  # =====================================================
  # API GATEWAY FOR EVENT INGESTION
  # =====================================================
  
  EventsAPI:
    Type: AWS::ApiGatewayV2::Api
    Properties:
      Name: !Sub '${ProjectName}-events-api-${Environment}'
      Description: REST API for ingesting real-time events
      ProtocolType: HTTP
      CorsConfiguration:
        AllowOrigins:
          - '*'
        AllowMethods:
          - POST
        AllowHeaders:
          - '*'

  EventsAPIIntegration:
    Type: AWS::ApiGatewayV2::Integration
    Properties:
      ApiId: !Ref EventsAPI
      IntegrationType: AWS_PROXY
      IntegrationUri: !GetAtt EventIngestionFunction.Arn
      PayloadFormatVersion: '2.0'

  EventsAPIRoute:
    Type: AWS::ApiGatewayV2::Route
    Properties:
      ApiId: !Ref EventsAPI
      RouteKey: 'POST /events'
      Target: !Sub 'integrations/${EventsAPIIntegration}'

  EventsAPIStage:
    Type: AWS::ApiGatewayV2::Stage
    Properties:
      ApiId: !Ref EventsAPI
      StageName: !Ref Environment
      AutoDeploy: true

  # =====================================================
  # LAMBDA FOR EVENT INGESTION
  # =====================================================
  
  EventIngestionFunction:
    Type: AWS::Lambda::Function
    Properties:
      FunctionName: !Sub '${ProjectName}-event-ingestion-${Environment}'
      Runtime: python3.11
      Handler: index.lambda_handler
      Role: !GetAtt LambdaCDCRole.Arn
      Code:
        ZipFile: |
          import json
          import boto3
          import os
          from datetime import datetime
          
          kinesis = boto3.client('kinesis')
          STREAM_NAME = os.environ['STREAM_NAME']
          
          def lambda_handler(event, context):
              try:
                  body = json.loads(event.get('body', '{}'))
                  
                  # Add metadata
                  body['event_timestamp'] = datetime.utcnow().isoformat() + 'Z'
                  body['source'] = 'web-app'
                  
                  # Send to Kinesis - PartitionKey MUST be string
                  response = kinesis.put_record(
                      StreamName=STREAM_NAME,
                      Data=json.dumps(body),
                      PartitionKey=str(body.get('user_id', 'default'))
                  )
                  
                  return {
                      'statusCode': 200,
                      'body': json.dumps({'message': 'Event ingested', 'sequenceNumber': response['SequenceNumber']})
                  }
              except Exception as e:
                  return {
                      'statusCode': 500,
                      'body': json.dumps({'error': str(e)})
                  }
      Environment:
        Variables:
          STREAM_NAME: !Ref EventsStream

  EventIngestionPermission:
    Type: AWS::Lambda::Permission
    Properties:
      FunctionName: !Ref EventIngestionFunction
      Action: lambda:InvokeFunction
      Principal: apigateway.amazonaws.com
      SourceArn: !Sub 'arn:aws:execute-api:${AWS::Region}:${AWS::AccountId}:${EventsAPI}/*/*'

  # =====================================================
  # GLUE JOBS (BATCH AND STREAMING)
  # =====================================================

  GlueStreamingJob:
    Type: AWS::Glue::Job
    Properties:
      Name: !Sub '${ProjectName}-events-streaming-${Environment}'
      Description: Stream events from Kinesis to Iceberg
      Role: !GetAtt GlueRole.Arn
      Command:
        Name: gluestreaming
        ScriptLocation: !Sub 's3://${DataLakeBucket}/glue-scripts/iceberg-streaming-bronze-layer.py'
        PythonVersion: '3'
      DefaultArguments:
        --job-language: python
        --enable-metrics: 'true'
        --enable-continuous-cloudwatch-log: 'true'
        --database_name: !Ref GlueDatabase
        --data_lake_bucket: !Ref DataLakeBucket
        --kinesis_stream_arn: !GetAtt EventsStream.Arn
        --starting_position: LATEST
        --window_size: '60 seconds'
        --checkpoint_location: !Sub 's3://${DataLakeBucket}/checkpoints/events-streaming/'
        --datalake-formats: iceberg
        --additional-python-modules: pyarrow==17.0.0,pyiceberg[glue]==0.9.0,pyiceberg-core==0.7.0
        --conf: !Sub |
          spark.sql.extensions=org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions
          --conf spark.sql.catalog.glue_catalog=org.apache.iceberg.spark.SparkCatalog
          --conf spark.sql.catalog.glue_catalog.warehouse=s3://${DataLakeBucket}/iceberg-streaming/
          --conf spark.sql.catalog.glue_catalog.catalog-impl=org.apache.iceberg.aws.glue.GlueCatalog
          --conf spark.sql.catalog.glue_catalog.io-impl=org.apache.iceberg.aws.s3.S3FileIO
          --conf spark.hadoop.fs.s3a.endpoint.region=${AWS::Region}
      GlueVersion: '4.0'
      NumberOfWorkers: 2
      WorkerType: G.1X

  # =====================================================
  # GLUE JOB FOR CDC TO ICEBERG CONVERSION (BATCH)
  # ====================================================

  CDCIcebergGlueJob:
    Type: AWS::Glue::Job
    Properties:
      Name: !Sub '${ProjectName}-iceberg-cdc-bronze-layer-${Environment}'
      Description: Convert CDC JSON data to Iceberg format
      Role: !GetAtt GlueRole.Arn
      
      Command:
        Name: glueetl
        ScriptLocation: !Sub 's3://${DataLakeBucket}/glue-scripts/iceberg-cdc-bronze-layer.py'
        PythonVersion: '3'
      
      DefaultArguments:
        --job-language: python
        --enable-metrics: true
        --enable-continuous-cloudwatch-log: true
        --database_name: !Ref GlueDatabase
        --data_lake_bucket: !Ref DataLakeBucket
        --datalake-formats: iceberg
        --cdc_data_path: !Sub 's3://${DataLakeBucket}/datasets/cdc_data/small'
        --target_year: 2024
        --aws_region: !Ref AWS::Region
        --additional-python-modules: pyarrow==17.0.0,pyiceberg[glue]==0.9.0,pyiceberg-core==0.7.0
        # Iceberg configuration
        --conf: !Sub |
          spark.sql.extensions=org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions
          --conf spark.sql.catalog.glue_catalog=org.apache.iceberg.spark.SparkCatalog
          --conf spark.sql.catalog.glue_catalog.warehouse=s3://${DataLakeBucket}/iceberg-cdc-bronze/
          --conf spark.sql.catalog.glue_catalog.catalog-impl=org.apache.iceberg.aws.glue.GlueCatalog
          --conf spark.sql.catalog.glue_catalog.io-impl=org.apache.iceberg.aws.s3.S3FileIO
      
      GlueVersion: '4.0'
      MaxRetries: 1
      Timeout: 30  # 30 minutes max
      NumberOfWorkers: 2  # Minimal for cost
      WorkerType: G.1X   # Smallest worker type

Outputs:
    # Deployment User Information
    DeploymentUserName:
      Description: IAM Username for deployment
      Value: !Ref DeploymentUser

    DeploymentUserAccessKeyId:
      Description: Access Key ID (SAVE THIS!)
      Value: !Ref DeploymentUserAccessKey
  
    DeploymentUserSecretAccessKey:
      Description: Secret Access Key (SAVE THIS - shown only once!)
      Value: !GetAtt DeploymentUserAccessKey.SecretAccessKey
  
    ConfigureAWSCLI:
      Description: Configure AWS CLI
      Value: !Sub |
        Run: aws configure --profile ${ProjectName}-${Environment}
        AWS Access Key ID: ${DeploymentUserAccessKey}
        AWS Secret Access Key: (from above)
        Default region name: ${AWS::Region}
        Default output format: json
  
    # Infrastructure Outputs
    DataLakeBucketName:
      Description: S3 Data Lake Bucket Name
      Value: !Ref DataLakeBucket
  
    LambdaCDCRoleArn:
      Description: Lambda CDC Role ARN
      Value: !GetAtt LambdaCDCRole.Arn
  
    GlueRoleArn:
      Description: Glue Role ARN
      Value: !GetAtt GlueRole.Arn
  
    GlueDatabaseName:
      Description: Glue Database Name
      Value: !Ref GlueDatabase
  
    # Streaming Components
    EventsStreamArn:
      Description: Kinesis Events Stream ARN
      Value: !GetAtt EventsStream.Arn
  
    APIEndpoint:
      Description: REST API endpoint for real-time events
      Value: !Sub 'https://${EventsAPI}.execute-api.${AWS::Region}.amazonaws.com/${Environment}/events'
  
    EventIngestionFunctionName:
      Description: Lambda function for event ingestion
      Value: !Ref EventIngestionFunction
  
    # Job Information
    GlueStreamingJobName:
      Description: Glue Streaming Job Name
      Value: !Ref GlueStreamingJob
  
    GlueBatchJobName:
      Description: CDC to Iceberg Batch Job Name
      Value: !Ref CDCIcebergGlueJob
  
    GlueStreamingJobArn:
      Description: Glue Streaming Job ARN
      Value: !Sub 'arn:aws:glue:${AWS::Region}:${AWS::AccountId}:job/${GlueStreamingJob}'
  
    GlueBatchJobArn:
      Description: CDC to Iceberg Batch Job ARN
      Value: !Sub 'arn:aws:glue:${AWS::Region}:${AWS::AccountId}:job/${CDCIcebergGlueJob}'
  
    # Usage Instructions
    StartStreamingJobCommand:
      Description: Command to start the real-time streaming job
      Value: !Sub 'aws glue start-job-run --job-name ${GlueStreamingJob}'
  
    StartBatchJobCommand:
      Description: Command to manually run the batch CDC job
      Value: !Sub 'aws glue start-job-run --job-name ${CDCIcebergGlueJob}'
  
    UploadCDCData:
      Description: Upload CDC JSON files to this S3 location (for batch processing)
      Value: !Sub 's3://${DataLakeBucket}/cdc-raw-data/'
  
    TestRealtimeEvent:
      Description: Test real-time event ingestion
      Value: !Sub |
        curl -X POST ${EventsAPI}.execute-api.${AWS::Region}.amazonaws.com/${Environment}/events \
        -H "Content-Type: application/json" \
        -d '{"user_id": "123", "event_type": "page_view", "page": "/products", "timestamp": "2024-01-01T12:00:00Z"}'
  
    NextSteps:
      Description: What to do next
      Value: !Sub |
        ✅ Complete E-commerce Analytics Pipeline deployed!
        
        What was created:
        - S3 Data Lake Bucket: ${DataLakeBucket}
        - Glue Database: ${GlueDatabase}
        - Batch CDC Job: ${CDCIcebergGlueJob}
        - Streaming Job: ${GlueStreamingJob}
        - Kinesis Stream: ${EventsStream}
        - REST API: https://${EventsAPI}.execute-api.${AWS::Region}.amazonaws.com/${Environment}/events
        - Lambda Function: ${EventIngestionFunction}
        - IAM Deployment User and Roles
        - Auto-cleanup: S3 objects expire after 7 days
        
        Data Flows:
        1. BATCH CDC: Upload JSON → S3 → Glue Batch → Iceberg
        2. REAL-TIME: API → Lambda → Kinesis → Glue Streaming → Iceberg
        
        Next steps:
        Batch Processing:
        1. Upload CDC JSON files to: s3://${DataLakeBucket}/datasets/cdc_data/small/
        2. Upload batch script to: s3://${DataLakeBucket}/glue-scripts/iceberg-cdc-bronze-layer.py
        3. Run: aws glue start-job-run --job-name ${CDCIcebergGlueJob}
        
        Real-time Processing:
        1. Upload streaming script to: s3://${DataLakeBucket}/glue-scripts/kinesis-to-iceberg-streaming.py
        2. Start: aws glue start-job-run --job-name ${GlueStreamingJob}
        3. Send events to: https://${EventsAPI}.execute-api.${AWS::Region}.amazonaws.com/${Environment}/events
        
        Cleanup: Delete this stack to remove all resources